name: Numbat Real Model Launch

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  launch:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install requests
        run: pip install requests

      - name: Launch Numbat
        id: launch
        continue-on-error: true
        run: |
          set +e
          python scripts/launch_model_test.py 2>&1 | tee launch-console.log
          code=${PIPESTATUS[0]}
          echo "launch_exit_code=$code" >> "$GITHUB_OUTPUT"
          exit "$code"

      - name: Save diagnostic logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: numbat-launch-diagnostics
          path: |
            numbat_launch.log
            launch-console.log
          if-no-files-found: warn
          retention-days: 7

      - name: Report
        if: always()
        run: |
          echo "Exit code: ${{ steps.launch.outputs.launch_exit_code }}"
          echo "Logs saved as numbat-launch-diagnostics"
